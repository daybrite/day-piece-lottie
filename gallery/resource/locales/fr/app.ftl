# Les chaînes de la galerie day-piece-lottie : un catalogue privé, lu par toute app qui monte ces
# pages sans avoir à l'installer.

# Le nom de la page bac à sable.
nav_picker = Sélecteur

# Le sélecteur d'animations du bac à sable (animations/).
animation = Animation

# Les animations, dans l'ordre de src/lib.rs : les deux fichiers propres à la galerie, puis les
# exemples d'Airbnb d'animations/lottie/.
anim_hello = Bonjour (carré)
anim_hamburger = Hamburger en flèche
anim_logo1 = Logo Lottie
anim_logo1_masked = Logo Lottie, masqué
anim_logo2 = Logo Lottie, deuxième version
anim_nine_squares = Neuf carrés
anim_motion_corpse = Motion corpse
anim_pin_jump = Saut d'épingle
anim_twitter_heart = Cœur
anim_boat_loader = Bateau de chargement
anim_icon_transitions = Transitions d'icônes
anim_switch = Interrupteur

# La ligne sous chaque titre : ce que montre le fichier.
note_hello = Un carré qui grandit et tourne, écrit à la main pour cette démo.
note_hamburger = Une icône de menu qui devient une flèche de retour, la transition d'une barre d'app.
note_logo1 = Le logo avec lequel Lottie a été lancé : 48 calques de formes qui dessinent le mot.
note_logo1_masked = Le même logo derrière un masque : les lettres sont révélées plutôt que dessinées.
note_logo2 = La deuxième version du logo, et le fichier le plus lourd ici avec 74 calques.
note_nine_squares = Neuf carrés qui échangent leurs places en boucle, par Al Boardman.
note_motion_corpse = Une composition 1920 × 1080 de Jr.canest, mise à l'échelle de la vue.
note_pin_jump = Une épingle de carte qui atterrit, écrasée et étirée pour lui donner du poids.
note_twitter_heart = Un cœur qui se remplit et éclate, à 60 images par seconde.
note_boat_loader = Le fichier le plus long ici : 888 images d'un bateau sur l'eau, en quatre précompositions.
note_icon_transitions = Des icônes qui se transforment l'une en l'autre, comme une barre d'onglets.
note_switch = Un interrupteur à la taille d'une commande, 100 × 100 points.

# Le panneau du bac à sable : ce que src/model.rs lit dans le fichier choisi.
model_section = Dans le fichier
model_name = Nom
model_frames = Images
model_duration = Durée
model_size = Taille
model_layers = Calques
model_issues = Problèmes
model_unnamed = (sans nom)
model_error = Impossible de lire le fichier

# Commandes de lecture.
playback_section = Lecture
speed = Vitesse

# Le sélecteur au-dessus des pages quand une app les montre en une seule (`gallery()`).
